# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key

# Primary database (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/users

# Dedicated test database (used only when running pytest)
# Must be a SEPARATE database from DATABASE_URL - the test suite creates and
# drops tables in this database on every run.
TEST_DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/users_test

# Origins allowed to call the API from a browser (the admin-ui dev server).
# Vite auto-increments the port (5173 -> 5174 -> ...) if one is already in
# use, so a small range is whitelisted here to avoid CORS breaking on
# every restart.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
